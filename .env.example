# ==============================================================================
# IUDX QA Automation - Unified Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to .env before running: docker compose up -d
#
# NOTE: Never commit your real .env file with production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL Container)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iudxqa
POSTGRES_PORT=5432

# Database connection string used by the backend service.
# Format: postgresql://<user>:<password>@postgres:5432/<database>
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/iudxqa

# ------------------------------------------------------------------------------
# 2. Backend Application Configuration
# ------------------------------------------------------------------------------
# Set to 'development' to automatically sync and create Sequelize schema on startup.
# Set to 'production' with DB_SYNC=none once migrations are established.
NODE_ENV=development
DB_SYNC=alter
BACKEND_PORT=4000

# Directory containing the Postman collections inside the container (default: collections)
COLLECTIONS_DIR=collections

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:8080,http://localhost:5173

# Publicly accessible URL for the backend API (used for links generated in reports/emails)
PUBLIC_API_URL=http://localhost:4000

# URL of the frontend dashboard (used in Newman report back-buttons)
DASHBOARD_URL=http://localhost:8080

# Trigger a complete run of all collections immediately after server boots
AUTO_RERUN_ON_STARTUP=false

# ------------------------------------------------------------------------------
# 3. Keycloak Authentication
# ------------------------------------------------------------------------------
KEYCLOAK_URL=https://v2.dev.iudx.io/auth
KEYCLOAK_REALM=iudx-v2
KEYCLOAK_FRONTEND_CLIENT_ID=frontend-client
KEYCLOAK_CLIENT_ID=frontend-client
KEYCLOAK_API_AUDIENCE=account

# ------------------------------------------------------------------------------
# 4. Email (SMTP) & Reporting Settings
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
QA_RECIPIENTS=

# ------------------------------------------------------------------------------
# 5. Frontend Dashboard Configuration
# ------------------------------------------------------------------------------
# Host port on which Nginx is published (use 8080 for unprivileged/rootless Docker, or 80 for production)
FRONTEND_PORT=8080

# Build arguments for Vite frontend (embedded into static client assets)
VITE_KEYCLOAK_URL=https://v2.dev.iudx.io/auth
VITE_KEYCLOAK_REALM=iudx-v2
VITE_KEYCLOAK_CLIENT_ID=frontend-client
# Leave empty to use relative /api/ proxied directly by Nginx
VITE_API_BASE_URL=
