# API base URL reachable from the user's browser (e.g. http://localhost:4000)
VITE_API_BASE_URL=http://localhost:4000
VITE_KEYCLOAK_URL=https://keycloak.example.com
VITE_KEYCLOAK_REALM=your-realm
# Public browser client ID. Use a Keycloak public client with Standard Flow and PKCE S256.
VITE_KEYCLOAK_CLIENT_ID=iudxqa-frontend
