# Server port (defaults to 4000)
PORT=4000

# Directory containing the Postman collection and environment JSON files.
# Relative paths are resolved from the application root.
COLLECTIONS_DIR="collections"

# Editable runtime state for the Control Plane consumer password. Keep this
# file outside Git and on persistent storage in deployments.
CONTROL_PLANE_PASSWORD_FILE="data/control-plane-password.json"

# Local PostgreSQL connection string.
DATABASE_URL="postgres://postgres:password@localhost:5432/iudxqa"

# Local development only. Creates and adjusts Sequelize tables automatically.
DB_SYNC="alter"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-iudxqa-frontend.example.com"

# Keycloak token validation. The frontend client is public and uses PKCE.
KEYCLOAK_URL="https://keycloak.example.com"
KEYCLOAK_REALM="your-realm"
KEYCLOAK_API_AUDIENCE="iudxqa-api"
KEYCLOAK_FRONTEND_CLIENT_ID="iudxqa-frontend"
# Keep any client secret server-side; signature verification does not require one.
# KEYCLOAK_CLIENT_SECRET=""

# Email (SMTP) settings used to send auto re-run reports
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="sender@example.com"
SMTP_PASS="your-app-password"
MAIL_FROM="IUDX QA Bot <sender@example.com>"

# Comma-separated list of emails that receive auto re-run reports
QA_RECIPIENTS="qa1@example.com,qa2@example.com"

# Public base URL of this backend, used for the per-collection Newman report links in the email
# (e.g. https://api.yourdomain.com in production)
PUBLIC_API_URL="http://localhost:4000"

# Frontend dashboard URL, used by the "Back to Dashboard" button in Newman reports
DASHBOARD_URL="http://localhost:8080"

# Run all collections and email the report right after the server starts (e.g. after a deploy),
# then continue at the configured interval. Keep false locally: `npm run dev` restarts on every file save.
AUTO_RERUN_ON_STARTUP=false
