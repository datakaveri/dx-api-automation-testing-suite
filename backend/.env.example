# Server port (defaults to 4000)
PORT=4000

# development - Local development only. Logs SQL queries to the console.
# production - Production and local development. Does not log SQL queries to the console.
NODE_ENV="production"

# Directory containing the Postman collection and environment JSON files.
# Relative paths are resolved from the application root.
COLLECTIONS_DIR="collections"

# Editable runtime state for the Control Plane consumer password. Keep this
# file outside Git and on persistent storage in deployments.
CONTROL_PLANE_PASSWORD_FILE="data/control-plane-password.json"

# Local PostgreSQL connection string.
DATABASE_URL="postgres://postgres:password@localhost:5432/iudxqa"

# alter - Local development only. Creates and adjusts Sequelize tables automatically.
# force - Local development only. Drops and recreates Sequelize tables automatically.
# none - Production and local development. Does not modify Sequelize tables automatically.
DB_SYNC="none" # none | alter | force

CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-iudxqa-frontend.example.com"

# Keycloak token validation. The frontend client is public and uses PKCE.
KEYCLOAK_URL="https://keycloak.example.com"
KEYCLOAK_REALM="your-realm"
KEYCLOAK_API_AUDIENCE="iudxqa-api"
KEYCLOAK_FRONTEND_CLIENT_ID="iudxqa-frontend"
# Keep any client secret server-side; signature verification does not require one.
# KEYCLOAK_CLIENT_SECRET=""

# Email (SMTP) settings used to send auto re-run reports
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="sender@example.com"
SMTP_PASS="your-app-password"
MAIL_FROM="IUDX QA Bot <sender@example.com>"

# Comma-separated list of emails that receive auto re-run reports
QA_RECIPIENTS="qa1@example.com,qa2@example.com"

# Public base URL of this backend, used for the per-collection Newman report links in the email
# (e.g. https://iudxqa-backend.slicearrow.com in production)
PUBLIC_API_URL="http://localhost:4000"

# Frontend dashboard URL, used by the "Open QA Dashboard" link in report emails and the
# "Back to Dashboard" button in Newman reports (e.g. https://iudxqa-dev.slicearrow.com)
DASHBOARD_URL="http://localhost:5173"

# Run all collections and email the report right after the server starts (e.g. after a deploy),
# then continue at the configured interval. Keep false locally: `npm run dev` restarts on every file save.
AUTO_RERUN_ON_STARTUP=false

# Run the optional gateway RabbitMQ cleanup after a Control Plane run.
RUN_GATEWAY_CLEANUP=false

# Run the NGSI-LD cleanup (Elasticsearch indices, RabbitMQ exchanges and user) after a Control Plane run.
RUN_NGSILD_CLEANUP=true

# Optional. Where post-run Python environments live. The Docker image sets its own and
# a blank value in --env-file would override it, so leave this commented.
# POST_RUN_VENV_ROOT=".post-run-venvs"

# ==================================================================
# TEST USERS AND SECRETS
# ------------------------------------------------------------------
# The committed Postman environment files, cleanup configs and
# config.ini contain ${VAR} placeholders. They are filled from the
# values below at run time:
#   - Postman ${VAR}: a missing variable STOPS the run.
#   - Cleanup configs ${VAR:-}: a missing variable becomes empty.
# Each block says which file reads it. Within a block: users first,
# then their passwords (same order), then optional values.
# With `docker run --env-file`: write values unquoted and keep
# comments on their own line (no "VAR=value # comment").
# ==================================================================


# ---------- 1. Shared by several suites ----------------------------
# COS admin. Read by the Control Plane, OGC and File Connect Postman envs.
COS_ADMIN_USER=
COS_ADMIN_PASSWORD=


# ---------- 2. Control Plane ---------------------------------------
# Read by: collections/Control Plane/contrlplane-evm.postman_environment.json
# Users. Postman keys: provider_user, consumer_user, org_admin,
# new_user, providerreq_user
CP_PROVIDER_USER=
CP_CONSUMER_USER=
CP_ORG_ADMIN_USER=
CP_NEW_USER=
CP_PROVIDERREQ_USER=
# Passwords for the users above, same order.
# CP_CONSUMER_PASS is a seed only: after a password rotation,
# data/control-plane-password.json wins.
CP_PROVIDER_PASS=
CP_CONSUMER_PASS=
CP_ORG_ADMIN_PASS=
CP_NEW_USER_PASS=
CP_PROVIDERREQ_PASS=
# Password the consumer is rotated TO during the run.
CP_NEW_PASSWORD_VALUE=
# Client / app secrets.
CP_CLIENT_SECRET=
CP_APP_SECRET=
CP_CREATED_CLIENT_SECRET=
# Optional. Login tokens (5 min lifetime): every run fetches fresh ones
# with the passwords above, so leave these empty.
CP_COSADMIN_TOKEN=
CP_ORGADMIN_TOKEN=
CP_PROVIDER_TOKEN=
CP_CONSUMER_TOKEN=
CP_PROVIDERREQ_TOKEN=
CP_NEW_USER_TOKEN=
CP_ADMIN_USER_TOKEN=
CP_MEMBER_TOKEN=


# ---------- 3. OGC -------------------------------------------------
# Read by: collections/OGC/OGC - DEV.postman_environment.json
# Users. Postman keys: provider_username, consumer_username,
# org_admin_username
OGC_PROVIDER_USER=
OGC_CONSUMER_USER=
OGC_ORG_ADMIN_USER=
# Passwords for the users above, same order.
OGC_PROVIDER_PASSWORD=
OGC_CONSUMER_PASSWORD=
OGC_ORG_ADMIN_PASSWORD=
# Optional. Filled during the run, so leave these empty.
OGC_PROVIDER_TOKEN=
OGC_CONSUMER_TOKEN=
OGC_COSADMIN_TOKEN=
OGC_ORG_ADMIN_TOKEN=
OGC_INVALID_TOKEN=
OGC_TILES_JOB_ID=
OGC_APPEND_JOB_ID=
OGC_STAC_ASSET_UPLOAD_ID=
OGC_STAC_ASSET_PART_URL=
OGC_PRESIGNED_URL=


# ---------- 4. Data Plane ------------------------------------------
# Read by: collections/Data Plane/*.postman_environment.json
# Users. Postman key: consumer_user
DP_CONSUMER_USER=
# Password for the user above.
DP_CONSUMER_PASS=
# Client / app secrets.
DP_CLIENT_SECRET=
DP_APPID_USERNAME_PASS=
# Static token, not refreshed by the collection: update it here when it expires.
DP_CONSUMER_TOKEN=


# ---------- 5. File Connect ----------------------------------------
# Read by: collections/File Connect/*.postman_environment.json and the
# collection's own variables. (COS admin user and password come from section 1.)
# Users. Postman keys: providerUsername, orgAdminUsername,
# consumerUsername, newuser
FC_PROVIDER_USER=
FC_ORG_ADMIN_USER=
FC_CONSUMER_USER=
FC_NEW_USER=
# Passwords. Postman keys: providerPassword, consumerPassword.
# newuser also logs in with FC_CONSUMER_PASSWORD (Postman key newuserpass).
FC_PROVIDER_PASSWORD=
FC_CONSUMER_PASSWORD=
# Optional. Signed S3 upload URL: each run creates a fresh one, so leave empty.
FC_PRESIGNED_PART_UPLOAD_URL=


# ---------- 6. Sandbox Connect -------------------------------------
# Read by: collections/Sandbox Connect/*.postman_environment.json
# Users. Postman key: auth_username
SC_AUTH_USER=
# Password for the user above.
SC_AUTH_PASSWORD=
# Tokens are not refreshed by the collection.
SC_NOTEBOOK_ACCESS_TOKEN=
SC_ROTATED_REFRESH_TOKEN=


# ==================================================================
# POST-RUN CLEANUP SCRIPTS
# ------------------------------------------------------------------
# Each script reads <script>_config.json next to it. Create it from the
# committed <script>_config.json.example (the arrow shows the config field).
# ==================================================================

# ---------- 7. Shared by the Control Plane cleanup scripts ---------
# Postgres password -> postgres.password
# (organisation_deletion, compute_credit_cleanup, platform_provider_cleanup)
PG_PASS=
# Keycloak admin client secret -> keycloak.admin_client_secret
# (compute_credit_cleanup, platform_provider_cleanup)
KC_ADMIN_CLIENT_SECRET=
# COS admin password -> actors.cos_admin.password
# (compute_credit_cleanup, platform_provider_cleanup)
CLEANUP_COS_ADMIN_PASSWORD=


# ---------- 8. organisation_deletion_config.json -------------------
# -> keycloak.admin_client_secret
ORG_DEL_KC_ADMIN_CLIENT_SECRET=
# -> actor.password
ORG_DEL_ACTOR_PASSWORD=


# ---------- 9. compute_credit_cleanup_config.json ------------------
# -> target.password (post-run.json also passes --password from the run)
CC_TARGET_PASSWORD=


# ---------- 10. platform_provider_cleanup_config.json --------------
# -> target.username, target.user_id (optional), target.password,
#    target.token (optional)
PP_CLEANUP_USERNAME=
PP_CLEANUP_USER_ID=
PP_CLEANUP_PASSWORD=
PP_CLEANUP_TOKEN=


# ---------- 11. NGSILD_Automation_Script/config.ini ----------------
# Users -> kibana.username, rabbitmq.username
NGSILD_KIBANA_USER=
NGSILD_RABBITMQ_USER=
# Passwords for the users above, same order.
NGSILD_KIBANA_PASSWORD=
NGSILD_RABBITMQ_PASSWORD=


# ---------- 12. OGC S3 cleanup: OGC_Automation_Script/config.json --
OGC_S3_ACCESS_KEY_ID=
OGC_S3_SECRET_ACCESS_KEY=
